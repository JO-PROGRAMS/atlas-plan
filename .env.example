# Copy this file to ".env" and fill in your own values.
# NEVER share your real keys publicly.

# Google Gemini API key (for the Gemini Flash model)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Notion integration token
NOTION_TOKEN="secret_notion_integration_token"

# Notion database ID for your Study List
NOTION_DATABASE_ID="your_study_list_database_id"

# Notion page ID for your Study Log
STUDY_LOG_PAGE_ID="your_study_log_page_id"

